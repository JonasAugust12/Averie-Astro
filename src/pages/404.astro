---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillLink from '@/components/landing/PillLink.astro';
import { bookingUrl } from '@/lib/site';
---

<BaseLayout
    title="Page Not Found | Averie Nails & Spa"
    description="The page you're looking for could not be found. Visit Averie Nails & Spa in Cohasset, MA for luxury nail and spa services."
    canonical="/404"
    robots="noindex, follow"
>
    <main
        id="main-content"
        class="flex min-h-[70vh] flex-col items-center justify-center py-16 text-center"
    >
        <p class="font-sans text-sm font-semibold uppercase tracking-[0.14em] text-nude">404</p>
        <h1 class="mt-3 font-display text-3xl font-semibold text-third sm:text-4xl">
            Page not found
        </h1>
        <p class="mt-4 max-w-md font-sans text-base text-secondary-600">
            The page you requested does not exist. Return home or book your appointment online.
        </p>
        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
            <PillLink href="/">Back to Home</PillLink>
            <PillLink href={bookingUrl()} variant="outline">Book an Appointment</PillLink>
        </div>
    </main>
</BaseLayout>
