---
import { isPromotionActive } from '@/lib/promotion';
import { bookingUrl } from '@/lib/site';
import { landingImages } from '@/lib/landing-images';
import LanguageSwitcher from '@/components/landing/LanguageSwitcher.astro';
import LandingImage from '@/components/landing/LandingImage.astro';
import { landingInteractive } from '@/lib/styles';

const nav = [
    ...(isPromotionActive() ? [{ href: '#promotion', label: 'Promotion' }] : []),
    { href: '#philosophy', label: 'About' },
    { href: '#services', label: 'Service' },
    { href: '#pricing', label: 'Menu' },
    { href: '#hours', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 px-3 pt-3 sm:px-4 sm:pt-4 md:px-8 md:pt-5">
    <div
        id="landing-nav-shell"
        class="border border-white/70 bg-cream/70 shadow-[0_8px_32px_rgb(58_48_39/0.08)] backdrop-blur-xl transition-[border-radius] duration-300 rounded-3xl px-4 py-2.5 sm:py-3 md:px-6 md:py-3.5"
    >
        <nav class="relative flex items-center justify-between gap-3">
            <a href="/" class={`relative z-10 shrink-0 ${landingInteractive}`}>
                <LandingImage
                    src={landingImages.logo}
                    alt="Averie"
                    width={157}
                    height={50}
                    priority
                    class="h-10 w-32 object-contain object-left sm:h-11 sm:w-36 md:h-12.5 md:w-39.25"
                />
            </a>

            <div
                class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-3.5 lg:flex lg:gap-6 xl:gap-8"
            >
                {
                    nav.map((item) => (
                        <a
                            href={item.href}
                            class={`nav-link-underline whitespace-nowrap pb-1 font-sans text-sm font-medium text-secondary-600 transition-colors hover:text-nude lg:text-base ${landingInteractive}`}
                        >
                            {item.label}
                        </a>
                    ))
                }
            </div>

            <div class="relative z-10 flex items-center gap-2 sm:gap-3">
                <LanguageSwitcher />
                <a
                    href={bookingUrl()}
                    class={`hidden h-9.5 items-center justify-center whitespace-nowrap rounded-full bg-third px-4 font-sans text-xs font-semibold uppercase tracking-wider text-cream shadow-xs transition-all duration-300 hover:-translate-y-0.5 hover:bg-primary-800 lg:inline-flex lg:h-10.5 lg:px-6 ${landingInteractive}`}
                >
                    Book Now
                </a>
                <button
                    type="button"
                    id="landing-nav-toggle"
                    class={`flex size-10 items-center justify-center rounded-full border border-stone-200/50 bg-white/70 text-third shadow-2xs transition-colors hover:bg-white active:scale-95 lg:hidden ${landingInteractive}`}
                    aria-label="Menu"
                    aria-expanded="false"
                    aria-controls="landing-mobile-menu"
                >
                    <svg
                        id="landing-nav-icon-open"
                        class="size-5"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <line x1="4" x2="20" y1="12" y2="12"></line>
                        <line x1="4" x2="20" y1="6" y2="6"></line>
                        <line x1="4" x2="20" y1="18" y2="18"></line>
                    </svg>
                    <svg
                        id="landing-nav-icon-close"
                        class="hidden size-5"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M18 6 6 18"></path>
                        <path d="m6 6 12 12"></path>
                    </svg>
                </button>
            </div>
        </nav>

        <div id="landing-mobile-menu" class="hidden lg:hidden">
            <div class="mt-4 flex flex-col gap-2 border-t border-stone-200/60 pt-4">
                {
                    nav.map((item) => (
                        <a
                            href={item.href}
                            class={`group flex items-center justify-between rounded-2xl px-4 py-3 font-sans text-base font-medium text-secondary-600 transition-all hover:bg-white/80 hover:text-nude landing-mobile-link ${landingInteractive}`}
                        >
                            <span class="flex items-center gap-2">{item.label}</span>
                        </a>
                    ))
                }
                <a
                    href={bookingUrl()}
                    class={`mt-3 flex h-12 items-center justify-center gap-2 rounded-full bg-third font-sans text-xs font-semibold uppercase tracking-wider text-cream shadow-md transition-transform active:scale-98 landing-mobile-link ${landingInteractive}`}
                >
                    <span>Book Now</span>
                </a>
            </div>
        </div>
    </div>
</header>
