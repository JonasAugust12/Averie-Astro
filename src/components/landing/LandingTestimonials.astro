---
import LandingImage from '@/components/landing/LandingImage.astro';
import FadeIn from '@/components/landing/FadeIn.astro';
import { landingImages } from '@/lib/landing-images';
import {
    landingBleedLeft,
    landingBody,
    landingEyebrow,
    landingOrnamentDesktopOnly,
    landingStaticText,
    landingTitle,
} from '@/lib/styles';

const reviews = [
    {
        author: 'Sarah Jenkins',
        initials: 'SJ',
        text: 'The attention to detail here is unmatched. It feels like a high-end sanctuary, and my nails have never looked more elegant or lasted longer. Highly recommend!',
    },
    {
        author: 'Elena Rostova',
        initials: 'ER',
        text: 'I came for a facial and a manicure. The experience was absolutely heavenly. The luxury design, refined scent, and professional technicians made my day.',
    },
    {
        author: 'Amanda Miller',
        initials: 'AM',
        text: "Averie delivers the perfect quiet luxury experience. It's clean, minimalist, and beautifully executed. Booking online is ultra-smooth!",
    },
];
---

<section
    id="testimonials"
    class="relative isolate py-12 md:py-24"
    aria-labelledby="testimonials-title"
>
    <!-- Decorative bubbles (soft luxury nude ambient glows) -->
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-visible md:hidden">
        <div
            class="absolute top-1/4 -left-6 h-60 w-60 rounded-full bg-nude/10 blur-3xl animate-ambient-pulse md:-left-16"
            style="animation-delay: 1.5s;"
        >
        </div>
        <div
            class="absolute bottom-4 -right-6 h-64 w-64 rounded-full bg-tertiary-300/12 blur-3xl animate-ambient-pulse md:-right-16"
            style="animation-delay: 4.5s;"
        >
        </div>
    </div>
    <div
        class:list={[
            'absolute bottom-0 z-0 aspect-3/4 w-56 translate-y-1/2 md:w-72',
            landingBleedLeft,
            landingOrnamentDesktopOnly,
        ]}
    >
        <LandingImage
            src={landingImages.heroOrnament02}
            alt=""
            width={450}
            height={458}
            class="h-full w-full rotate-180 object-cover"
        />
    </div>

    <div class="relative z-10">
        <FadeIn class="mb-8 text-center md:mb-10">
            <div class={landingEyebrow}>
                <span>Client Love</span>
            </div>
            <h2 id="testimonials-title" class={`mt-3 ${landingTitle}`}>What our clients say</h2>
        </FadeIn>

        <div
            class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 scrollbar-none md:mx-0 md:grid md:grid-cols-3 md:gap-6 md:overflow-visible md:px-0 md:pb-0"
        >
            {
                reviews.map((review, i) => (
                    <FadeIn
                        delay={i * 0.08}
                        class="w-[84vw] max-w-85 shrink-0 snap-center md:w-auto md:max-w-none"
                    >
                        <article class="flex h-full flex-col rounded-4xl border border-stone-200/90 bg-linear-to-b from-cream via-cream/90 to-tertiary-100/50 p-6 shadow-[0_12px_32px_-8px_rgba(58,48,39,0.08)] md:rounded-3xl md:shadow-sm md:transition-transform md:duration-300 md:hover:-translate-y-1">
                            <div
                                class="mb-3 flex gap-1 text-nude md:mb-4"
                                role="img"
                                aria-label="5 out of 5 stars"
                            >
                                <span
                                    class="select-none text-base leading-none tracking-widest md:text-lg"
                                    aria-hidden="true"
                                >
                                    ★★★★★
                                </span>
                            </div>
                            <blockquote
                                class={`flex-1 font-sans text-sm italic leading-relaxed text-secondary-600 md:not-italic ${landingBody}`}
                            >
                                &ldquo;{review.text}&rdquo;
                            </blockquote>
                            <footer class="mt-5 flex items-center gap-3 border-t border-stone-100 pt-4 md:mt-6 md:border-0 md:pt-0">
                                <div
                                    class={`flex size-10 shrink-0 items-center justify-center rounded-full bg-third font-sans text-xs font-semibold text-cream shadow-xs md:size-12.5 md:text-sm ${landingStaticText}`}
                                >
                                    {review.initials}
                                </div>
                                <div class={landingStaticText}>
                                    <p class="font-sans text-sm font-semibold text-third md:text-base">
                                        {review.author}
                                    </p>
                                    <p class="font-sans text-[11px] text-muted md:hidden">
                                        Averie Member
                                    </p>
                                </div>
                            </footer>
                        </article>
                    </FadeIn>
                ))
            }
        </div>
    </div>
</section>
