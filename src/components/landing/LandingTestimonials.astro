---
import LandingImage from '@/components/landing/LandingImage.astro';
import FadeIn from '@/components/landing/FadeIn.astro';
import { landingImages } from '@/lib/landing-images';
import {
    landingBleedLeft,
    landingBody,
    landingEyebrow,
    landingOrnamentDesktopOnly,
    landingStaticText,
    landingTitle,
} from '@/lib/styles';

const reviews = [
    {
        author: 'Sarah Jenkins',
        initials: 'SJ',
        text: 'The attention to detail here is unmatched. It feels like a high-end sanctuary, and my nails have never looked more elegant or lasted longer. Highly recommend!',
    },
    {
        author: 'Elena Rostova',
        initials: 'ER',
        text: 'I came for a facial and a manicure. The experience was absolutely heavenly. The luxury design, refined scent, and professional technicians made my day.',
    },
    {
        author: 'Amanda Miller',
        initials: 'AM',
        text: "Averie delivers the perfect quiet luxury experience. It's clean, minimalist, and beautifully executed. Booking online is ultra-smooth!",
    },
];
---

<section
    id="testimonials"
    class="relative isolate py-12 md:py-24"
    aria-labelledby="testimonials-title"
>
    <!-- Decorative bubbles (framing the testimonial cards gracefully) -->
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-visible">
        <div
            class="absolute top-1/4 -left-6 h-60 w-60 rounded-full bg-primary02/25 blur-3xl animate-ambient-pulse md:-left-16"
            style="animation-delay: 1.5s;"
        >
        </div>
        <div
            class="absolute bottom-4 -right-6 h-64 w-64 rounded-full bg-primary01/25 blur-3xl animate-ambient-pulse md:-right-16"
            style="animation-delay: 4.5s;"
        >
        </div>
    </div>
    <div
        class:list={[
            'absolute bottom-0 z-0 aspect-3/4 w-56 translate-y-1/2 md:w-72',
            landingBleedLeft,
            landingOrnamentDesktopOnly,
        ]}
    >
        <LandingImage
            src={landingImages.heroOrnament02}
            alt=""
            width={450}
            height={458}
            class="h-full w-full rotate-180 object-cover"
        />
    </div>

    <div class="relative z-10">
        <FadeIn class="mb-8 text-center md:mb-10">
            <div class={landingEyebrow}>
                <span>Client Love</span>
            </div>
            <h2 id="testimonials-title" class={`mt-3 ${landingTitle}`}>What our clients say</h2>
        </FadeIn>

        <div
            class="md:hidden -mx-4 flex snap-x snap-mandatory overflow-x-auto gap-4 px-4 pb-4 scrollbar-none"
        >
            {
                reviews.map((review, i) => (
                    <FadeIn delay={i * 0.08} class="w-[84vw] max-w-85 shrink-0 snap-center">
                        <article class="flex h-full flex-col rounded-4xl border border-stone-200/80 bg-white/95 p-6 shadow-[0_12px_32px_-8px_rgba(58,48,39,0.08)]">
                            <div class="mb-3 flex gap-1 text-nude" aria-hidden="true">
                                {Array.from({ length: 5 }).map(() => (
                                    <svg
                                        class="size-4.5 fill-current stroke-none"
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 24 24"
                                    >
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                    </svg>
                                ))}
                            </div>
                            <blockquote
                                class={`flex-1 font-sans text-sm italic leading-relaxed text-secondary-600 ${landingStaticText}`}
                            >
                                &ldquo;{review.text}&rdquo;
                            </blockquote>
                            <footer class="mt-5 flex items-center gap-3 border-t border-stone-100 pt-4">
                                <div
                                    class={`flex size-10 items-center justify-center rounded-full bg-third font-sans text-xs font-semibold text-cream shadow-xs ${landingStaticText}`}
                                >
                                    {review.initials}
                                </div>
                                <div class={landingStaticText}>
                                    <p class="font-sans text-sm font-semibold text-third">
                                        {review.author}
                                    </p>
                                    <p class="font-sans text-[11px] text-muted">Averie Member</p>
                                </div>
                            </footer>
                        </article>
                    </FadeIn>
                ))
            }
        </div>

        <div class="hidden gap-6 md:grid md:grid-cols-3">
            {
                reviews.map((review, i) => (
                    <FadeIn delay={i * 0.08}>
                        <article class="flex h-full flex-col rounded-card bg-white p-6 shadow-sm transition-transform duration-300 hover:-translate-y-1">
                            <div class="mb-4 flex gap-1 text-nude" aria-hidden="true">
                                {Array.from({ length: 5 }).map(() => (
                                    <svg
                                        class="size-6.5 fill-current stroke-none"
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 24 24"
                                    >
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                    </svg>
                                ))}
                            </div>
                            <blockquote class={`flex-1 ${landingBody}`}>
                                &ldquo;{review.text}&rdquo;
                            </blockquote>
                            <footer class="mt-6 flex items-center gap-3">
                                <div
                                    class={`flex size-12.5 items-center justify-center rounded-full bg-third font-sans text-sm font-medium text-cream ${landingStaticText}`}
                                >
                                    {review.initials}
                                </div>
                                <p
                                    class={`font-sans text-base font-medium text-third ${landingStaticText}`}
                                >
                                    {review.author}
                                </p>
                            </footer>
                        </article>
                    </FadeIn>
                ))
            }
        </div>
    </div>
</section>
