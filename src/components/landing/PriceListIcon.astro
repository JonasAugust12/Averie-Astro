            <circle cx="12" cy="12" r="1.75" />
            <path d="M4 7c3 0 6 3 6 5s-3 5-6 5L2 7h2z" />
            <path d="M20 7c-3 0-6 3-6 5s3 5 6 5l2-10h-2z" />
