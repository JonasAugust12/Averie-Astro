{
    /* 12. Dermalogica Facials: Skincare Spa Drop & Lotus Petal */
    icon === 'facial' && (
        <svg
            class={className}
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
