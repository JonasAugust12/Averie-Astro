---
import { SEO } from '@/lib/site';
import { landingImages } from '@/lib/landing-images';
import LandingImage from '@/components/landing/LandingImage.astro';
import DecorativeImage from '@/components/landing/DecorativeImage.astro';
import {
    landingBleedFooter,
    landingBleedSecondary600,
    landingInteractive,
    landingStaticText,
} from '@/lib/styles';
---

<footer
    class:list={['pt-14 pb-0 text-secondary-900', landingBleedFooter]}
    aria-labelledby="footer-contact-title"
>
    {/* Full-width Luxury Gradient Divider Line at Top */}
    <div
        class="absolute -top-0.5 left-1/2 -z-10 h-0.5 w-screen -translate-x-1/2 bg-linear-to-r from-transparent via-nude/70 to-transparent"
        aria-hidden="true"
    >
    </div>

    <div class="grid gap-10 md:grid-cols-12 md:gap-10">
        <div
            class="flex flex-col items-center text-center md:col-span-4 md:items-start md:text-left"
        >
            <div
                class={`relative flex size-48 items-center justify-center sm:size-52 md:aspect-square md:w-[85%] md:max-w-72 md:size-auto ${landingStaticText}`}
            >
                <LandingImage
                    src={landingImages.logoRound}
                    alt="Averie"
                    width={240}
                    height={240}
                    class="h-full w-full object-contain"
                />
            </div>
        </div>

        <div
            class="flex flex-col items-center text-center md:col-span-4 md:items-start md:text-left"
        >
            <p
                id="footer-contact-title"
                class={`mb-4 flex w-full items-center justify-center gap-2 border-b border-nude/30 pb-2 font-sans text-sm font-bold tracking-widest uppercase text-nude md:justify-start md:text-base ${landingStaticText}`}
            >
                Contact
            </p>
            <address class="flex flex-col items-center gap-3.5 not-italic md:items-start">
                <a
                    href={`tel:${SEO.phone}`}
                    class="font-sans text-xl font-bold tracking-tight text-secondary-900 transition-colors hover:text-nude md:text-2xl"
                >
                    781-923-1955
                </a>
                <div class="flex flex-col text-center md:text-left">
                    <p
                        class="font-sans text-base font-bold leading-tight text-secondary-900 md:text-lg"
                    >
                        132 Chief Justice Cushing Hwy
                    </p>
                    <p class="mt-1 font-sans text-sm font-medium text-secondary-600 md:text-base">
                        Cohasset, MA 02025
                    </p>
                </div>
            </address>

            <div class="mt-6 flex justify-center gap-4 md:mt-7 md:justify-start">
                <a
                    href={SEO.social.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`group flex size-14 items-center justify-center rounded-2xl bg-white/90 border border-nude/25 p-2.5 shadow-[0_4px_16px_rgba(148,90,66,0.12)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-nude hover:border-nude hover:shadow-lg active:scale-95 md:size-15 md:rounded-2xl ${landingInteractive}`}
                    aria-label="Instagram"
                >
                    <DecorativeImage
                        src="/icons/instagram.svg"
                        width={40}
                        height={40}
                        class="size-8 transition-transform duration-300 group-hover:scale-110 md:size-9"
                    />
                </a>
                <a
                    href={SEO.social.facebook}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`group flex size-14 items-center justify-center rounded-2xl bg-white/90 border border-nude/25 p-2.5 shadow-[0_4px_16px_rgba(148,90,66,0.12)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-nude hover:border-nude hover:shadow-lg active:scale-95 md:size-15 md:rounded-2xl ${landingInteractive}`}
                    aria-label="Facebook"
                >
                    <DecorativeImage
                        src="/icons/facebook.svg"
                        width={40}
                        height={40}
                        class="size-8 transition-transform duration-300 group-hover:scale-110 md:size-9"
                    />
                </a>
            </div>
        </div>

        <div
            class="flex flex-col items-center text-center md:col-span-4 md:items-start md:text-left"
        >
            <p
                class={`mb-4 flex w-full items-center justify-center gap-2 border-b border-nude/30 pb-2 font-sans text-sm font-bold tracking-widest uppercase text-nude md:justify-start md:text-base ${landingStaticText}`}
            >
                Our Location
            </p>
            <div
                id="footer-map-container"
                class="aspect-4/3 w-full overflow-hidden rounded-2xl border border-nude/30 bg-cream shadow-xs md:rounded-xl"
            >
                <iframe
                    id="footer-map-iframe"
                    title="Averie salon location on Google Maps"
                    data-src="https://maps.google.com/maps?q=Averie%20Nails%20Spa%20Cohasset%20MA&t=&z=17&ie=UTF8&iwloc=&output=embed"
                    width="100%"
                    height="100%"
                    style="border: 0"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
            <script is:inline>
                (function () {
                    const mapContainer = document.getElementById('footer-map-container');
                    const mapIframe = document.getElementById('footer-map-iframe');
                    if (!mapContainer || !mapIframe) return;

                    function loadMap() {
                        if (mapIframe.dataset.src) {
                            mapIframe.src = mapIframe.dataset.src;
                            delete mapIframe.dataset.src;
                        }
                    }

                    if ('IntersectionObserver' in window) {
                        const observer = new IntersectionObserver(
                            function (entries) {
                                if (entries[0].isIntersecting) {
                                    loadMap();
                                    observer.disconnect();
                                }
                            },
                            { rootMargin: '200px' },
                        );
                        observer.observe(mapContainer);
                    } else {
                        loadMap();
                    }
                })();
            </script>
        </div>
    </div>

    {/* Deep Taupe Accent Copyright Bar at Bottom */}
    <div
        class:list={[
            'relative mt-12 flex flex-col items-center py-5 text-center shadow-[0_-4px_16px_rgba(0,0,0,0.06)]',
            landingBleedSecondary600,
        ]}
    >
        <p
            class={`relative z-10 px-4 font-sans text-xs font-medium text-cream/95 md:px-0 md:text-sm ${landingStaticText}`}
        >
            Copyright © 2026 Averie. All rights reserved.
        </p>
    </div>
</footer>
