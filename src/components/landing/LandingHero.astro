---
import { bookingUrl, SEO } from '@/lib/site';
import { landingImages } from '@/lib/landing-images';
import PillLink from '@/components/landing/PillLink.astro';
import LandingImage from '@/components/landing/LandingImage.astro';
import FadeIn from '@/components/landing/FadeIn.astro';
import {
    landingBody,
    landingDesktopOnly,
    landingEyebrow,
    landingImageFrame,
    landingMobileOnly,
    landingStaticText,
} from '@/lib/styles';
---

<section class="relative z-20 py-8 sm:py-12 md:py-16" aria-labelledby="hero-title">
    <!-- Decorative bubbles (gentle contrast harmonious with nude) -->
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-visible md:hidden">
        <div
            class="absolute top-12 left-4 h-64 w-64 rounded-full bg-primary02/15 blur-3xl animate-ambient-pulse md:left-12 sm:h-72 sm:w-72"
        >
        </div>
        <div
            class="absolute -bottom-16 right-4 h-72 w-72 rounded-full bg-primary01/15 blur-3xl animate-ambient-pulse md:-bottom-20 md:right-16 sm:h-80 sm:w-80"
            style="animation-delay: 3.5s;"
        >
        </div>
    </div>
    <div class="relative z-10 grid items-center gap-8 md:grid-cols-12 md:gap-8">
        <FadeIn
            class="flex flex-col items-center text-center md:col-span-5 md:items-start md:text-left"
        >
            <div class={landingEyebrow}>
                <span>Averie Nails Spa</span>
            </div>

            <h1 id="hero-title" class={`mt-4 ${landingStaticText}`}>
                <span
                    class="block font-display text-4xl font-semibold uppercase leading-[1.08] tracking-tight text-nude sm:text-5xl md:text-6xl lg:text-7xl xl:text-hero"
                >
                    Averie
                </span>
                <span
                    class="mt-2 block font-display text-xl font-medium leading-snug tracking-tight text-third sm:text-2xl md:text-3xl"
                >
                    Luxury Nail Salon & Spa in Cohasset, MA
                </span>
            </h1>

            <p
                class={`mt-3 font-sans text-xs font-semibold uppercase tracking-[0.12em] text-nude/90 sm:text-sm sm:tracking-[0.14em] ${landingStaticText}`}
            >
                Manicures · Pedicures · Gel · Acrylic · Dip Powder · Gel X · Facials · Waxing
            </p>

            <p class={`mt-3.5 max-w-lg md:mt-5 ${landingBody} text-secondary-600`}>
                Averie Nails Spa offers professional nail and beauty services in Cohasset,
                Massachusetts, serving clients throughout the South Shore. Book your appointment
                online today.
            </p>

            <div
                class="mt-8 flex w-full flex-col items-center gap-3 sm:flex-row sm:justify-center md:justify-start"
            >
                <PillLink
                    href={bookingUrl()}
                    class="flex items-center justify-center gap-2 sm:max-w-none"
                >
                    Book an Appointment
                </PillLink>
                <PillLink
                    href="tel:+17819231955"
                    variant="outline"
                    class="inline-flex h-12.5 w-full items-center justify-center gap-2 rounded-full border border-third/30 bg-white/60 px-6 font-sans text-sm font-medium tracking-wide text-third backdrop-blur-xs transition-colors sm:w-auto md:hidden"
                >
                    <svg
                        class="size-4"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        ><path
                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                        ></path></svg
                    >
                    <span>781-923-1955</span>
                </PillLink>
            </div>

            <a
                href={SEO.maps}
                target="_blank"
                rel="noopener noreferrer"
                class={`mt-5 inline-flex items-center gap-2 text-xs font-medium text-stone-600 transition-colors hover:text-third ${landingStaticText}`}
            >
                <div class="flex text-amber-500" role="img" aria-label="5 out of 5 stars">
                    {
                        Array.from({ length: 5 }).map(() => (
                            <svg
                                class="size-3.5 fill-current"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                            </svg>
                        ))
                    }
                </div>
                <span class="font-semibold text-stone-800">5.0 on Google</span>
                <span class="text-stone-400">•</span>
                <span>Cohasset, MA</span>
            </a>
        </FadeIn>

        <FadeIn delay={0.12} class="md:col-span-7">
            <div class={`relative mx-auto w-full max-w-sm ${landingMobileOnly}`}>
                <div
                    class="absolute -inset-2 -z-10 rounded-[2.5rem] bg-linear-to-tr from-nude/25 via-secondary/20 to-cream/50 blur-xl"
                >
                </div>
                <div
                    class="relative aspect-3/4 w-full overflow-hidden rounded-4xl border border-white/80 bg-white/50 p-2 shadow-[0_20px_40px_-15px_rgba(58,48,39,0.18)]"
                >
                    <div
                        class={`relative h-full w-full overflow-hidden rounded-3xl ${landingImageFrame}`}
                    >
                        <LandingImage
                            src={landingImages.hero}
                            alt="Averie salon interior — luxury nail and beauty care in Cohasset, MA"
                            width={500}
                            height={667}
                            priority
                            class="h-full w-full translate-x-[4%] object-cover transition-transform duration-1000 group-hover:scale-105"
                        />
                    </div>
                    <div
                        class={`absolute bottom-4 left-4 right-4 flex items-center justify-between rounded-full border border-white/80 bg-white/90 px-4 py-2 shadow-md backdrop-blur-md ${landingStaticText}`}
                    >
                        <span class="font-sans text-xs font-semibold tracking-wide text-third"
                            >Sanctuary of Calm</span
                        >
                        <span
                            class="font-sans text-[11px] font-medium uppercase tracking-wider text-nude"
                            >Est. Cohasset</span
                        >
                    </div>
                </div>
            </div>

            <div class={`relative mx-auto h-150 w-full max-w-125 ${landingDesktopOnly}`}>
                <div
                    class="pointer-events-none absolute -right-40 -top-30 z-10 aspect-3/4 w-[80%] rounded-card"
                >
                    <LandingImage
                        src={landingImages.heroOrnament01}
                        alt=""
                        width={450}
                        height={462}
                        aboveFold
                        class="h-full w-full object-cover"
                    />
                </div>
                <div
                    class="pointer-events-none absolute -bottom-18 -left-40 z-10 aspect-3/4 w-[80%] rounded-card"
                >
                    <LandingImage
                        src={landingImages.heroOrnament02}
                        alt=""
                        width={450}
                        height={458}
                        aboveFold
                        class="h-full w-full object-cover"
                    />
                </div>
                <div
                    class={`absolute left-1/2 top-1/2 z-20 aspect-3/4 w-[68%] -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-card ${landingImageFrame}`}
                >
                    <LandingImage
                        src={landingImages.hero}
                        alt="Averie Nails Spa - luxury nail salon and spa services in Cohasset, MA"
                        width={500}
                        height={750}
                        priority
                        class="h-full w-full object-cover transition-transform duration-2000 group-hover:scale-105"
                    />
                </div>
            </div>
        </FadeIn>
    </div>
</section>
