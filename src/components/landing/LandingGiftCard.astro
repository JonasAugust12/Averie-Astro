---
import { Image } from 'astro:assets';
import { cn } from '@/lib/cn';
import { landingImages } from '@/lib/landing-images';
import { landingBody, landingEyebrow, landingTitle } from '@/lib/styles';

const giftColor = '#c0957f';
---

<section
    id="gift-cards"
    class={cn(
        'relative isolate py-10 sm:py-14 md:py-20',
        "before:pointer-events-none before:absolute before:inset-y-0 before:left-1/2 before:-z-10 before:w-screen before:-translate-x-1/2 before:content-['']",
        'before:bg-[linear-gradient(to_right,rgba(120,113,108,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(120,113,108,0.06)_1px,transparent_1px)] before:bg-size-[24px_24px]',
    )}
    aria-labelledby="gift-card-title"
>
    {/* Running Text Luxury Ticker */}
    <div
        class="relative mb-6 md:mb-8 w-full overflow-hidden rounded-full border border-nude/20 bg-linear-to-r from-white/90 via-tertiary-50/90 to-white/90 py-2 sm:py-2.5 shadow-xs backdrop-blur-md"
    >
        <div
            class="pointer-events-none absolute inset-y-0 left-0 z-10 w-8 sm:w-12 bg-linear-to-r from-cream to-transparent"
        >
        </div>
        <div
            class="pointer-events-none absolute inset-y-0 right-0 z-10 w-8 sm:w-12 bg-linear-to-l from-cream to-transparent"
        >
        </div>
        <div
            class="animate-marquee whitespace-nowrap text-[11px] sm:text-xs font-semibold uppercase tracking-[0.18em] sm:tracking-[0.22em] text-nude select-none"
        >
            <span class="mx-4 sm:mx-6 inline-flex items-center gap-2">
                <svg
                    class="h-3 w-3 sm:h-3.5 sm:w-3.5 text-primary02"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path
                        d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"
                    ></path>
                </svg>
                ✦ THE PERFECT GIFT ✦ BEAUTY & RELAXATION ✦ GIFT CARDS AVAILABLE IN-STORE ✦ TREAT SOMEONE
                SPECIAL ✦ LUXURY SPA EXPERIENCE
            </span>
            <span class="mx-4 sm:mx-6 inline-flex items-center gap-2">
                <svg
                    class="h-3 w-3 sm:h-3.5 sm:w-3.5 text-primary02"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path
                        d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"
                    ></path>
                </svg>
                ✦ THE PERFECT GIFT ✦ BEAUTY & RELAXATION ✦ GIFT CARDS AVAILABLE IN-STORE ✦ TREAT SOMEONE
                SPECIAL ✦ LUXURY SPA EXPERIENCE
            </span>
        </div>
    </div>

    <div class="grid items-center gap-8 md:grid-cols-12 md:gap-8">
        {/* Left Column: Text */}
        <div
            class="flex flex-col items-center text-center md:col-span-5 md:items-start md:pr-4 md:text-left"
        >
            <div class={landingEyebrow}>
                <svg
                    class="h-3.5 w-3.5 animate-pulse-soft text-primary02"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path
                        d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"
                    ></path>
                </svg>
                <span>Gift Cards</span>
            </div>

            <h2 id="gift-card-title" class={cn('mt-4', landingTitle)}>Available In-Store Only</h2>

            <p class={cn('mt-3.5 md:mt-4 max-w-lg', landingBody, 'text-secondary-600')}>
                Simply show someone you care by treating them to a little beauty, relaxation, and
                luxury at Averie Nails Spa. ✨
            </p>
        </div>

        {/* Right Column: Gift Card Image & Floating Accents */}
        <div class="flex md:col-span-7 md:justify-end">
            <div class="relative mx-auto w-full min-w-60 max-w-120 md:mx-0">
                {/* Celebratory luxury floating accents & sparkles */}
                <div
                    class="pointer-events-none absolute -top-5 -left-5 z-20 animate-float-slow drop-shadow-md"
                    style={{ color: giftColor }}
                    aria-hidden="true"
                >
                    <svg
                        class="h-7 w-7"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path
                            d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"
                        ></path>
                    </svg>
                </div>
                <div
                    class="pointer-events-none absolute -bottom-4 -right-4 z-20 animate-float-slow-reverse text-nude drop-shadow-md"
                    aria-hidden="true"
                >
                    <svg
                        class="h-6 w-6"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M6 3h12l4 6-10 12L2 9z"></path>
                        <path d="M11 3 8 9l4 12 4-12-3-6"></path>
                        <path d="M2 9h20"></path>
                    </svg>
                </div>
                <div
                    class="pointer-events-none absolute top-8 -right-5 z-20 animate-confetti-float drop-shadow-xs"
                    style={{ color: `${giftColor}cc` }}
                    aria-hidden="true"
                >
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                        <path
                            d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"
                        ></path>
                    </svg>
                </div>
                <div
                    class="pointer-events-none absolute -bottom-3 left-6 z-20 animate-confetti-float text-primary01/70 drop-shadow-xs"
                    style={{ animationDelay: '1.2s' }}
                    aria-hidden="true"
                >
                    <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor">
                        <path
                            d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z"
                        ></path>
                    </svg>
                </div>

                {/* Ambient glow tinted by gift gold/nude */}
                <div
                    class="absolute -inset-4 -z-10 rounded-4xl blur-xl animate-ambient-pulse"
                    style={{
                        background: `radial-gradient(ellipse at 60% 40%, ${giftColor}35 0%, ${giftColor}15 45%, transparent 75%)`,
                    }}
                >
                </div>

                {/* Card Frame */}
                <div
                    class="relative overflow-hidden rounded-[1.75rem] bg-white p-2 sm:p-2.5"
                    style={{
                        border: `1px solid ${giftColor}35`,
                        boxShadow: `0 20px 44px -16px ${giftColor}35, 0 0 0 1px rgba(58,48,39,0.06)`,
                    }}
                >
                    {/* Corner Ribbon with shine sweep */}
                    <div
                        class="pointer-events-none absolute right-0 top-0 z-20 h-28 w-28 overflow-hidden"
                        aria-hidden="true"
                    >
                        <div
                            class="relative -right-8 top-6 w-38 rotate-45 overflow-hidden py-1.5 text-center text-[10px] font-bold uppercase tracking-[0.16em] text-white"
                            style={{
                                boxShadow: `0 4px 12px ${giftColor}55`,
                                background: `linear-gradient(to right, color-mix(in srgb, ${giftColor} 90%, black), ${giftColor}, color-mix(in srgb, ${giftColor} 90%, black))`,
                            }}
                        >
                            <div
                                class="absolute inset-0 -translate-x-full animate-shine bg-linear-to-r from-transparent via-white/40 to-transparent"
                            >
                            </div>
                            GIFT CARD
                        </div>
                    </div>

                    {/* Image Container with aspect ratio and subtle animation */}
                    <div
                        class="animate-promotion-wiggle relative mx-auto w-full overflow-hidden rounded-[1.35rem] bg-linear-to-b from-stone-100 to-stone-50/80 flex items-center justify-center aspect-3/2"
                    >
                        <Image
                            src={landingImages.giftCard}
                            alt="Averie Nails Spa Gift Cards"
                            width={1536}
                            height={1024}
                            format="webp"
                            loading="lazy"
                            decoding="async"
                            draggable="false"
                            class="h-full w-full object-cover pointer-events-none select-none [-webkit-user-drag:none]"
                        />
                        <div
                            class="pointer-events-none absolute inset-0 -translate-x-full animate-shine bg-linear-to-r from-transparent via-white/35 to-transparent z-10"
                        >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
