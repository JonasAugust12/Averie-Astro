---
import FadeIn from '@/components/landing/FadeIn.astro';
import ClosureNoticeIcon from '@/components/landing/ClosureNoticeIcon.astro';
import {
    closureNotice,
    isClosureNoticeActive,
    normalizeClosureIcon,
    resolveClosureEyebrow,
} from '@/lib/closure-notice';
import { landingBleedWhite, landingBody, landingEyebrow, landingStaticText } from '@/lib/styles';

const active = isClosureNoticeActive();
const icon = normalizeClosureIcon(closureNotice.icon);
const eyebrow = resolveClosureEyebrow(closureNotice);
const iconMotionClass = icon === 'storm' ? 'storm-icon-float' : 'animate-float-slow';
---

{
    active && (
        <section
            id="closure-notice"
            class:list={['relative z-10 py-6 sm:py-10 md:py-12', landingBleedWhite]}
            aria-labelledby="closure-notice-title"
        >
            <FadeIn class="mx-auto max-w-2xl px-3 sm:px-4 lg:max-w-3xl">
                <div
                    class:list={[
                        'relative overflow-hidden rounded-2xl border border-nude/30 bg-linear-to-br from-white via-cream/80 to-tertiary-50/70 p-5 text-center shadow-[0_16px_45px_-15px_rgba(58,48,39,0.18)] backdrop-blur-xs sm:rounded-3xl sm:p-8 md:p-10',
                        landingStaticText,
                    ]}
                >
                    <div
                        class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-linear-to-r from-transparent via-third/70 to-transparent"
                        aria-hidden="true"
                    />
                    <div
                        class="pointer-events-none absolute -right-12 -top-12 size-40 rounded-full bg-slate-400/10 blur-2xl sm:size-52"
                        aria-hidden="true"
                    />
                    <div
                        class="pointer-events-none absolute -bottom-16 -left-12 size-48 rounded-full bg-primary02/15 blur-3xl sm:size-60"
                        aria-hidden="true"
                    />

                    <div class="relative z-10 flex flex-col items-center">
                        <div
                            class:list={[
                                'relative mb-4 flex size-20 items-center justify-center rounded-full border border-white/80 bg-white/90 shadow-[0_12px_30px_-10px_rgba(58,48,39,0.2)] backdrop-blur-sm sm:mb-5 sm:size-24',
                                iconMotionClass,
                            ]}
                            aria-hidden="true"
                        >
                            <div class="absolute inset-3 rounded-full bg-slate-300/15 blur-xl" />
                            <ClosureNoticeIcon icon={icon} class="relative size-14 sm:size-16" />
                        </div>

                        <div class={landingEyebrow}>
                            <span
                                class="animate-pulse-soft inline-flex size-2 rounded-full bg-third"
                                aria-hidden="true"
                            />
                            <span class="tracking-[0.16em] sm:tracking-[0.18em]">{eyebrow}</span>
                        </div>

                        <h2
                            id="closure-notice-title"
                            class="mt-4 font-display text-xl font-semibold uppercase leading-snug tracking-wide text-nude sm:mt-5 sm:text-2xl md:text-3xl lg:text-4xl"
                        >
                            {closureNotice.headline}
                        </h2>

                        <div class="my-3.5 flex items-center gap-2.5 sm:my-4" aria-hidden="true">
                            <span class="h-px w-6 bg-nude/25 sm:w-10" />
                            <span class="size-1.5 rotate-45 border border-third/60" />
                            <span class="h-px w-6 bg-nude/25 sm:w-10" />
                        </div>

                        <p
                            class={`max-w-xl ${landingBody} text-sm text-secondary-700 sm:text-base md:text-lg`}
                        >
                            {closureNotice.reason}
                        </p>

                        <div class="mt-4 w-full max-w-xl rounded-xl border border-nude/25 bg-white/80 px-4 py-3.5 shadow-2xs backdrop-blur-md sm:mt-5 sm:rounded-2xl sm:px-6 sm:py-4">
                            <p class="font-sans text-sm font-semibold leading-relaxed text-secondary-800 sm:text-base md:text-lg">
                                {closureNotice.announcement}
                            </p>
                        </div>

                        <p
                            class={`mt-4 max-w-xl ${landingBody} text-xs text-secondary-600 sm:mt-5 sm:text-sm md:text-base`}
                        >
                            {closureNotice.message}
                        </p>
                    </div>
                </div>
            </FadeIn>
        </section>
    )
}
