---
import FadeIn from '@/components/landing/FadeIn.astro';
import PillLink from '@/components/landing/PillLink.astro';
import LandingImage from '@/components/landing/LandingImage.astro';
import { landingImages, scaledImageDimensions } from '@/lib/landing-images';
import {
    landingBody,
    landingBleedWhite,
    landingDesktopOnly,
    landingEyebrowMuted,
    landingImageFrame,
    landingMobileOnly,
    landingStaticText,
    landingTitle,
} from '@/lib/styles';

const salonImage = scaledImageDimensions(landingImages.salon, 400);
---

<section
    id="philosophy"
    aria-labelledby="philosophy-title"
    class:list={[
        'grid items-center gap-8 py-12 md:grid-cols-12 md:gap-6 md:py-24',
        landingBleedWhite,
    ]}
>
    <FadeIn class="relative order-2 md:order-0 md:col-span-7 md:pb-20">
        <div class={`relative mx-auto w-full max-w-sm px-2 ${landingMobileOnly}`}>
            <div
                class="relative aspect-3/4 w-full overflow-hidden rounded-4xl border border-stone-200/80 bg-white/60 p-2 shadow-[0_16px_36px_-10px_rgba(58,48,39,0.12)]"
            >
                <div
                    class={`relative h-full w-full overflow-hidden rounded-3xl ${landingImageFrame}`}
                >
                    <LandingImage
                        src={landingImages.salon}
                        alt="Averie salon atmosphere — welcoming beauty and wellness space"
                        width={salonImage.width}
                        height={salonImage.height}
                        aboveFold
                        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                </div>
            </div>
            <div class={`absolute -top-3 left-4 z-20 ${landingStaticText}`}>
                <div
                    class="inline-flex items-center gap-1.5 rounded-full border border-white/80 bg-white/90 px-3.5 py-1.5 shadow-md backdrop-blur-md"
                >
                    <span class="font-sans text-xs font-semibold tracking-wide text-third"
                        >The Averie Ritual</span
                    >
                </div>
            </div>
        </div>

        <div class={`relative mx-auto aspect-4/4.25 w-full max-w-129.5 ${landingDesktopOnly}`}>
            <div class="pointer-events-none absolute -right-50 -top-44 z-10 aspect-3/4 w-[80%]">
                <LandingImage
                    src={landingImages.heroOrnament01}
                    alt=""
                    width={450}
                    height={462}
                    aboveFold
                    class="h-full w-full object-cover"
                />
            </div>
            <div class="pointer-events-none absolute -bottom-30 -left-40 z-10 aspect-3/4 w-[80%]">
                <LandingImage
                    src={landingImages.heroOrnament02}
                    alt=""
                    width={450}
                    height={458}
                    aboveFold
                    class="h-full w-full object-cover"
                />
            </div>
            <div class={`relative z-20 h-full w-full overflow-hidden ${landingImageFrame}`}>
                <LandingImage
                    src={landingImages.salon}
                    alt="About Averie — thoughtful beauty care in Cohasset"
                    width={salonImage.width}
                    height={salonImage.height}
                    aboveFold
                    class="mx-auto h-full w-full object-contain object-center transition-transform duration-700 group-hover:scale-[1.03]"
                />
            </div>
        </div>
    </FadeIn>

    <FadeIn
        delay={0.1}
        class="order-1 flex flex-col items-center text-center md:order-0 md:col-span-5 md:max-w-md md:justify-self-end md:items-start md:pr-8 md:text-left"
    >
        <div class={landingEyebrowMuted}>
            <span>Our Philosophy</span>
        </div>
        <h2 id="philosophy-title" class={`mt-3 ${landingTitle}`}>About Us</h2>
        <p class={`mt-4 max-w-lg ${landingBody} text-secondary-600 md:mt-6 md:text-justify`}>
            At Averie, we've created a welcoming space where beauty, comfort, and thoughtful care
            come together. From the moment you arrive, our goal is to help you feel relaxed and well
            cared for. Every detail, from our inviting atmosphere to the quality of our services, is
            thoughtfully considered to make your visit feel personal, comfortable, and enjoyable.
        </p>
        <PillLink href="#services" class="mt-7 w-full sm:w-auto md:w-40">Explore</PillLink>
    </FadeIn>
</section>
