---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { cn } from '@/lib/cn';
import { landingImage } from '@/lib/styles';

interface Props {
    src: ImageMetadata;
    alt: string;
    width: number;
    height: number;
    class?: string;
    /** LCP-critical: eager load + fetchpriority high */
    priority?: boolean;
    /** Visible in first viewport: eager load, normal fetch priority */
    aboveFold?: boolean;
    fit?: 'cover' | 'contain' | 'fill' | 'inside' | 'outside';
    /** Responsive `sizes` for srcset selection (does not change source quality). */
    sizes?: string;
    /** Width variants for srcset; defaults to display width and 2x. */
    imageWidths?: number[];
}

const {
    src,
    alt,
    width,
    height,
    class: className = '',
    priority = false,
    aboveFold = false,
    fit = 'inside',
    sizes,
    imageWidths,
} = Astro.props;

const loading = priority || aboveFold ? 'eager' : 'lazy';
const resolvedWidths = imageWidths ?? [width, width * 2];
const resolvedSizes = sizes ?? `${width}px`;
---

<Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    fit={fit}
    widths={resolvedWidths}
    sizes={resolvedSizes}
    class={cn(landingImage, className)}
    loading={loading}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    draggable="false"
/>
