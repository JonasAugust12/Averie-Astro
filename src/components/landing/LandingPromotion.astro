---
import promotionData from '@/data/promotion.json';
import { cn } from '@/lib/cn';
import { landingBody, landingEyebrow, landingTitle, landingStaticText } from '@/lib/styles';

interface PromotionConfig {
    enabled: boolean;
    title: string;
    description: string;
    imageUrl: string;
    imageWidth?: number;
    imageHeight?: number;
    color: string;
    startDate?: string;
    endDate?: string;
    ctaText?: string;
    ctaLink?: string;
}

const promotion = promotionData as PromotionConfig;

function isPromotionActive(promo: PromotionConfig): boolean {
    if (!promo.enabled) return false;
    const now = new Date();
    if (promo.startDate) {
        const start = new Date(promo.startDate);
        if (now < start) return false;
    }
    if (promo.endDate) {
        const end = new Date(promo.endDate);
        if (now > end) return false;
    }
    return true;
}

const active = isPromotionActive(promotion);

function formatPromotionDate(dateStr: string): string {
    try {
        const d = new Date(dateStr);
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
        return dateStr;
    }
}

let periodLabel: string | null = null;
if (promotion.startDate && promotion.endDate) {
    periodLabel = `${formatPromotionDate(promotion.startDate)} – ${formatPromotionDate(promotion.endDate)}`;
} else if (promotion.startDate) {
    periodLabel = `From ${formatPromotionDate(promotion.startDate)}`;
} else if (promotion.endDate) {
    periodLabel = `Until ${formatPromotionDate(promotion.endDate)}`;
}

const promoColor = promotion.color || '#fd735d';
const aspectRatio =
    promotion.imageWidth && promotion.imageHeight
        ? `${promotion.imageWidth} / ${promotion.imageHeight}`
        : '4 / 5';

const ctaText = promotion.ctaText || 'Book Appointment';
const ctaLink = promotion.ctaLink || '/#hours';
---

{
    active && (
        <section
            id="promotion"
            class={cn(
                'relative isolate py-8 sm:py-12 md:py-24',
                "before:pointer-events-none before:absolute before:inset-y-0 before:left-1/2 before:-z-10 before:w-screen before:-translate-x-1/2 before:content-['']",
                'before:bg-[linear-gradient(to_right,rgba(120,113,108,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(120,113,108,0.06)_1px,transparent_1px)] before:bg-[size:24px_24px]',
            )}
        >
            {/* Running Text Luxury Ticker */}
            <div class="relative mb-6 md:mb-8 w-full overflow-hidden rounded-full border border-nude/20 bg-gradient-to-r from-white/90 via-tertiary-50/90 to-white/90 py-2 sm:py-2.5 shadow-xs backdrop-blur-md">
                <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-8 sm:w-12 bg-gradient-to-r from-cream to-transparent" />
                <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-8 sm:w-12 bg-gradient-to-l from-cream to-transparent" />
                <div class="animate-marquee whitespace-nowrap text-[11px] sm:text-xs font-semibold uppercase tracking-[0.18em] sm:tracking-[0.22em] text-nude select-none">
                    <span class="mx-4 sm:mx-6 inline-flex items-center gap-2">
                        <svg
                            class="h-3 w-3 sm:h-3.5 sm:w-3.5 text-primary02"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
                        </svg>
                        LIMITED OFFER • AVERIE BEAUTY SALON
                    </span>
                    <span class="mx-4 sm:mx-6 inline-flex items-center gap-2">
                        <svg
                            class="h-3 w-3 sm:h-3.5 sm:w-3.5 text-primary02"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
                        </svg>
                        EXCLUSIVE SEASONAL PROMOTION
                    </span>
                </div>
            </div>

            <div class="grid items-center gap-8 md:grid-cols-12 md:gap-8">
                {/* Left Column: Promotion Text & Actions */}
                <div class="flex flex-col items-center text-center md:col-span-5 md:items-start md:pr-4 md:text-left animate-landing-fade-in-up">
                    <div class={landingEyebrow}>
                        <svg
                            class="h-3.5 w-3.5 animate-pulse-soft text-primary02"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
                        </svg>
                        <span>Special Offer</span>
                    </div>

                    <h2 class={cn('mt-4 line-clamp-2', landingTitle)}>{promotion.title}</h2>

                    {promotion.description ? (
                        <p
                            class={cn(
                                'mt-3.5 md:mt-4 max-w-lg line-clamp-4 wrap-break-word',
                                landingBody,
                                'text-secondary-600',
                            )}
                        >
                            {promotion.description}
                        </p>
                    ) : null}

                    {/* Combined Urgency CTA and Validity Period */}
                    <div class="mt-5 sm:mt-6 md:mt-7 flex w-full flex-col items-center gap-2.5 sm:w-auto sm:flex-row sm:items-center">
                        <a
                            href={ctaLink}
                            class="group relative flex h-11.5 sm:h-12.5 w-full max-w-xs items-center justify-center gap-2 overflow-hidden rounded-full bg-third px-6 sm:px-8 text-xs sm:text-sm font-semibold uppercase tracking-wider text-cream shadow-[0_8px_20px_-4px_rgba(43,38,35,0.3)] transition-all duration-300 hover:shadow-[0_12px_28px_-6px_rgba(43,38,35,0.4)] hover:-translate-y-0.5 sm:w-auto sm:max-w-none"
                        >
                            <div class="pointer-events-none absolute inset-0 -translate-x-full animate-shine bg-gradient-to-r from-transparent via-white/25 to-transparent" />
                            <span>{ctaText}</span>
                            <svg
                                class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <>
                                    <path d="M5 12h14" />
                                    <path d="m12 5 7 7-7 7" />
                                </>
                            </svg>
                        </a>

                        {periodLabel ? (
                            <div
                                class={cn(
                                    'inline-flex w-full max-w-xs items-center justify-center gap-2 rounded-full border border-nude/25 bg-white/95 px-3.5 py-2 shadow-2xs backdrop-blur-xs sm:w-auto sm:max-w-none sm:justify-start sm:gap-2.5 sm:px-4 sm:py-2.5',
                                    landingStaticText,
                                )}
                            >
                                <span class="relative flex h-2 w-2 shrink-0 sm:h-2.5 sm:w-2.5">
                                    <span
                                        class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
                                        style={{ backgroundColor: promoColor }}
                                    />
                                    <span
                                        class="relative inline-flex h-2 w-2 rounded-full sm:h-2.5 sm:w-2.5"
                                        style={{ backgroundColor: promoColor }}
                                    />
                                </span>
                                <div class="flex flex-row items-center gap-1.5 text-left sm:flex-col sm:items-start sm:gap-0">
                                    <span class="font-sans text-[10px] font-bold uppercase tracking-[0.14em] text-nude sm:tracking-[0.16em]">
                                        Valid Period
                                    </span>
                                    <span class="hidden sm:inline font-sans text-xs font-semibold text-stone-800 md:text-sm">
                                        {periodLabel}
                                    </span>
                                    <span class="sm:hidden font-sans text-[11px] font-semibold text-stone-800">
                                        • {periodLabel}
                                    </span>
                                </div>
                            </div>
                        ) : null}
                    </div>
                </div>

                {/* Right Column: Promotion Card & Floating Accents */}
                <div class="flex md:col-span-7 md:justify-end animate-landing-fade-in-up">
                    <div class="relative mx-auto w-full min-w-60 max-w-105 md:mx-0">
                        {/* Celebratory luxury floating accents & sparkles */}
                        <div
                            class="pointer-events-none absolute -top-5 -left-5 z-20 animate-float-slow drop-shadow-md"
                            style={{ color: promoColor }}
                            aria-hidden="true"
                        >
                            <svg
                                class="h-7 w-7"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
                            </svg>
                        </div>
                        <div
                            class="pointer-events-none absolute -bottom-4 -right-4 z-20 animate-float-slow-reverse text-nude drop-shadow-md"
                            aria-hidden="true"
                        >
                            <svg
                                class="h-6 w-6"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <>
                                    <path d="M6 3h12l4 6-10 12L2 9z" />
                                    <path d="M11 3 8 9l4 12 4-12-3-6" />
                                    <path d="M2 9h20" />
                                </>
                            </svg>
                        </div>
                        <div
                            class="pointer-events-none absolute top-8 -right-5 z-20 animate-confetti-float drop-shadow-xs"
                            style={{ color: `${promoColor}cc` }}
                            aria-hidden="true"
                        >
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z" />
                            </svg>
                        </div>
                        <div
                            class="pointer-events-none absolute -bottom-3 left-6 z-20 animate-confetti-float text-primary01/70 drop-shadow-xs"
                            style={{ animationDelay: '1.2s' }}
                            aria-hidden="true"
                        >
                            <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z" />
                            </svg>
                        </div>

                        {/* Ambient glow tinted by promo color */}
                        <div
                            class="absolute -inset-4 -z-10 rounded-4xl blur-xl animate-ambient-pulse"
                            style={{
                                background: `radial-gradient(ellipse at 60% 40%, ${promoColor}35 0%, ${promoColor}15 45%, transparent 75%)`,
                            }}
                        />

                        {/* Card Frame */}
                        <div
                            class="relative overflow-hidden rounded-[1.75rem] bg-white p-2"
                            style={{
                                border: `1px solid ${promoColor}30`,
                                boxShadow: `0 20px 44px -16px ${promoColor}30, 0 0 0 1px rgba(58,48,39,0.06)`,
                            }}
                        >
                            {/* Corner Ribbon with shine sweep */}
                            <div
                                class="pointer-events-none absolute right-0 top-0 z-20 h-28 w-28 overflow-hidden"
                                aria-hidden="true"
                            >
                                <div
                                    class="relative -right-8 top-6 w-38 rotate-45 overflow-hidden py-1.5 text-center text-[10px] font-bold uppercase tracking-[0.16em] text-white"
                                    style={{
                                        boxShadow: `0 4px 12px ${promoColor}55`,
                                        background: `linear-gradient(to right, color-mix(in srgb, ${promoColor} 90%, black), ${promoColor}, color-mix(in srgb, ${promoColor} 90%, black))`,
                                    }}
                                >
                                    <div class="absolute inset-0 -translate-x-full animate-shine bg-gradient-to-r from-transparent via-white/40 to-transparent" />
                                    LIMITED OFFER
                                </div>
                            </div>

                            {/* Flexible Image Container with min/max height and object-contain */}
                            <div
                                class="animate-promotion-wiggle relative mx-auto w-full min-h-70 max-h-140 overflow-hidden rounded-[1.35rem] bg-gradient-to-b from-stone-100 to-stone-50/80 flex items-center justify-center"
                                style={{ aspectRatio, maxHeight: '560px' }}
                            >
                                {promotion.imageUrl ? (
                                    <img
                                        src={promotion.imageUrl}
                                        alt={promotion.title}
                                        loading="lazy"
                                        decoding="async"
                                        draggable="false"
                                        class="h-full w-full object-contain pointer-events-none select-none [-webkit-user-drag:none]"
                                    />
                                ) : null}
                                <div class="pointer-events-none absolute inset-0 -translate-x-full animate-shine bg-gradient-to-r from-transparent via-white/35 to-transparent z-10" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    )
}
