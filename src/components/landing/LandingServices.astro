---
import type { ImageMetadata } from 'astro';
import { bookingUrl } from '@/lib/site';
import { landingImages } from '@/lib/landing-images';
import FadeIn from '@/components/landing/FadeIn.astro';
import LandingImage from '@/components/landing/LandingImage.astro';
import {
    landingBody,
    landingEyebrow,
    landingImageFrame,
    landingInteractive,
    landingStaticText,
    landingTitle,
} from '@/lib/styles';

const cards: Array<{
    image: ImageMetadata;
    tag: string;
    alt: string;
    title: string;
    body: string;
}> = [
    {
        image: landingImages.manicurePedicure,
        tag: 'Hands & Feet',
        alt: 'Manicure and pedicure services at Averie',
        title: 'Manicure & Pedicure',
        body: 'Signature treatments for healthy, resilient nails and ultimate relaxation.',
    },
    {
        image: landingImages.dermalogicaFacials,
        tag: 'Dermalogica',
        alt: 'Dermalogica facial treatments at Averie',
        title: 'Dermalogica Facials',
        body: 'Customized face mapping, MicroZone treatments, and full skin therapies.',
    },
    {
        image: landingImages.enhancementsWaxing,
        tag: 'Gentle Care',
        alt: 'Nail enhancements and waxing at Averie',
        title: 'Enhancements & Waxing',
        body: 'Precision gel polish, acrylics, and gentle waxing services for flawless skin.',
    },
];
---

<section id="services" class="py-12 md:py-24" aria-labelledby="services-title">
    <FadeIn class="mb-8 text-center md:mb-12">
        <div class={landingEyebrow}>
            <span>Averie Offerings</span>
        </div>
        <h2 id="services-title" class={`mt-3 ${landingTitle}`}>Our services</h2>
        <p class={`mx-auto mt-3 max-w-xl ${landingBody}`}>
            Tailored treatments designed for lasting results and pure relaxation.
        </p>
    </FadeIn>

    <div
        class="md:hidden -mx-4 flex snap-x snap-mandatory overflow-x-auto gap-4 px-4 pb-4 scrollbar-none"
    >
        {
            cards.map((card, i) => (
                <FadeIn delay={i * 0.08} class="w-[84vw] max-w-85 shrink-0 snap-center">
                    <article class="flex h-full flex-col rounded-4xl border border-stone-200/80 bg-white/95 p-4 shadow-[0_12px_32px_-8px_rgba(58,48,39,0.1)] transition-all">
                        <div
                            class={`relative aspect-4/3 overflow-hidden rounded-3xl ${landingImageFrame}`}
                        >
                            <LandingImage
                                src={card.image}
                                alt={card.alt}
                                width={340}
                                height={255}
                                class="h-full w-full object-cover"
                            />
                            <div
                                class={`absolute top-3 left-3 rounded-full border border-white/80 bg-white/90 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-third shadow-xs backdrop-blur-md ${landingStaticText}`}
                            >
                                {card.tag}
                            </div>
                        </div>
                        <div class="flex flex-1 flex-col pt-4">
                            <h3
                                class={`text-center font-display text-xl font-semibold text-secondary-600 ${landingStaticText}`}
                            >
                                {card.title}
                            </h3>
                            <p
                                class={`mt-2 flex-1 text-center font-sans text-sm leading-relaxed text-body ${landingStaticText}`}
                            >
                                {card.body}
                            </p>
                            <a
                                href={bookingUrl()}
                                class={`mt-4 flex items-center justify-center gap-2 rounded-full border border-third/20 bg-cream/60 py-2.5 font-sans text-xs font-semibold uppercase tracking-wider text-third transition-colors hover:bg-third hover:text-cream ${landingInteractive}`}
                            >
                                <span>Book Service</span>
                                <svg
                                    class="size-3.5"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <>
                                        <path d="M5 12h14" />
                                        <path d="m12 5 7 7-7 7" />
                                    </>
                                </svg>
                            </a>
                        </div>
                    </article>
                </FadeIn>
            ))
        }
    </div>

    <div class="hidden gap-6 md:grid md:grid-cols-3">
        {
            cards.map((card, i) => (
                <FadeIn delay={i * 0.08}>
                    <article class="flex h-full flex-col rounded-3xl border border-stone-200/80 bg-white/95 p-5 shadow-[0_12px_32px_-8px_rgba(58,48,39,0.08)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_40px_-12px_rgba(58,48,39,0.12)] lg:rounded-4xl">
                        <div
                            class={`relative aspect-4/3 overflow-hidden rounded-2xl lg:rounded-3xl ${landingImageFrame}`}
                        >
                            <LandingImage
                                src={card.image}
                                alt={card.alt}
                                width={400}
                                height={300}
                                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                            />
                            <div
                                class={`absolute top-3.5 left-3.5 rounded-full border border-white/80 bg-white/90 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-third shadow-xs backdrop-blur-md ${landingStaticText}`}
                            >
                                {card.tag}
                            </div>
                        </div>
                        <div class="flex flex-1 flex-col pt-5">
                            <h3
                                class={`text-center font-display text-2xl font-semibold text-secondary-600 ${landingStaticText}`}
                            >
                                {card.title}
                            </h3>
                            <p
                                class={`mt-2.5 flex-1 text-center font-sans text-[15px] leading-relaxed text-body ${landingStaticText}`}
                            >
                                {card.body}
                            </p>
                            <a
                                href={bookingUrl()}
                                class={`mt-5 flex items-center justify-center gap-2 rounded-full border border-third/20 bg-cream/60 px-6 py-2.5 font-sans text-xs font-semibold uppercase tracking-wider text-third shadow-xs transition-all duration-200 hover:scale-[1.02] hover:bg-third hover:text-cream active:scale-95 ${landingInteractive}`}
                            >
                                <span>Book Service</span>
                                <svg
                                    class="size-3.5"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <>
                                        <path d="M5 12h14" />
                                        <path d="m12 5 7 7-7 7" />
                                    </>
                                </svg>
                            </a>
                        </div>
                    </article>
                </FadeIn>
            ))
        }
    </div>
</section>
