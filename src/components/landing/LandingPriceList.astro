    <!-- Section Header -->
    <FadeIn class="relative z-10 mb-8 text-center sm:mb-10 md:mb-14">
        <!-- Royal Emblem Accent Line -->
        <div class="mb-3.5 flex items-center justify-center gap-3 text-nude">
            <span class="h-px w-10 bg-linear-to-r from-transparent via-nude/40 to-nude/80 sm:w-16"
