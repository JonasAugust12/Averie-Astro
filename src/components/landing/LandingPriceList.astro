---
import { priceCategories } from '@/data/price-list';
import FadeIn from '@/components/landing/FadeIn.astro';
import PriceListIcon from '@/components/landing/PriceListIcon.astro';
import LandingImage from '@/components/landing/LandingImage.astro';
import { landingImages } from '@/lib/landing-images';
import { bookingUrl } from '@/lib/site';
import {
    landingBleedWhite,
    landingBleedRight,
    landingBleedLeft,
    landingBody,
    landingEyebrow,
    landingInteractive,
    landingOrnamentDesktopOnly,
    landingStaticText,
    landingTitle,
} from '@/lib/styles';

// Categorize items into filter groups for intuitive mobile & desktop navigation
type FilterGroup = 'all' | 'hands-feet' | 'gel-dip' | 'enhancements' | 'skincare' | 'addons';

interface FilterOption {
    id: FilterGroup;
    label: string;
    count: number;
}

const getFilterGroup = (categoryId: string): FilterGroup => {
    switch (categoryId) {
        case 'signature':
        case 'dessert':
        case 'me-time':
        case 'gentlemen':
        case 'little-diva':
            return 'hands-feet';
        case 'gel-polish':
        case 'dip':
            return 'gel-dip';
        case 'acrylic':
        case 'gel-x':
        case 'builder':
            return 'enhancements';
        case 'waxing':
        case 'facials':
            return 'skincare';
        case 'add-ons':
            return 'addons';
        default:
            return 'all';
    }
};

const filterGroupsCount = priceCategories.reduce(
    (acc, cat) => {
        const group = getFilterGroup(cat.id);
        acc[group] = (acc[group] || 0) + 1;
        return acc;
    },
    {} as Record<FilterGroup, number>,
);

const filters: FilterOption[] = [
    { id: 'all', label: 'All Menu', count: priceCategories.length },
    { id: 'hands-feet', label: 'Hands & Feet', count: filterGroupsCount['hands-feet'] || 0 },
    { id: 'addons', label: 'Add-Ons', count: filterGroupsCount['addons'] || 0 },
    { id: 'gel-dip', label: 'Gel & Dip', count: filterGroupsCount['gel-dip'] || 0 },
    { id: 'enhancements', label: 'Enhancements', count: filterGroupsCount['enhancements'] || 0 },
    { id: 'skincare', label: 'Facials & Waxing', count: filterGroupsCount['skincare'] || 0 },
];
---

