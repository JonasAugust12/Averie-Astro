                                        'price-filter-btn group inline-flex items-center gap-2 rounded-full px-4 py-2 font-sans text-xs font-semibold tracking-wider uppercase transition-all duration-300 cursor-pointer select-none active:scale-95 min-h-10 touch-manipulation border',
                                        index === 0
                                            ? 'bg-third text-cream border-nude/40 shadow-sm scale-[1.02]'
                                            : 'bg-transparent text-secondary-800 border-transparent hover:bg-nude/10 hover:text-secondary-900 hover:border-nude/25',
                                    ]}
                                >
                                    <svg
                                        class:list={[
                                            'filter-sparkle size-3 shrink-0 transition-all duration-300',
                                            index === 0
                                                ? 'text-nude opacity-100 scale-100'
                                                : 'text-nude opacity-0 scale-0 w-0 -mr-1',
                                        ]}
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 24 24"
                                        fill="currentColor"
                                        aria-hidden="true"
                                    >
                                        <path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.2L12 16.6l-6.3 4.6 2.3-7.2-6-4.6h7.6z" />
                                    </svg>
                                    <span>{filter.label}</span>
                                    <span
                                        class:list={[
