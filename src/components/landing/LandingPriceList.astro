                            <svg
                                class="pointer-events-none absolute bottom-2.5 right-2.5 size-7 scale-x-[-1] scale-y-[-1] text-nude/35 transition-all duration-300 group-hover:scale-x-[-1.05] group-hover:scale-y-[-1.05] group-hover:text-nude/70"
                                viewBox="0 0 36 36"
                                fill="none"
