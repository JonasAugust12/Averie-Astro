                                            index === 0
                                                ? 'bg-nude/25 text-cream border border-nude/30'
                                                : 'bg-nude/10 text-nude border border-nude/15 group-hover:bg-nude/20 group-hover:text-nude',
                                        ]}
                                    >
                                        {filter.count}
                                    </span>
                                </button>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </nav>
    </FadeIn>

