            <svg
                class="size-4 shrink-0 fill-current text-nude animate-pulse-soft"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                aria-hidden="true"
            >
                <path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.2L12 16.6l-6.3 4.6 2.3-7.2-6-4.6h7.6z"
                ></path>
            </svg>
            <span class="h-px w-10 bg-linear-to-l from-transparent via-nude/40 to-nude/80 sm:w-16"
            ></span>
        </div>

        <div class={landingEyebrow}>
            <span>Service Menu & Pricing</span>
        </div>
        <h2 id="pricing-title" class={`mt-3.5 ${landingTitle}`}>Price List</h2>
        <p class={`mx-auto mt-3.5 max-w-xl ${landingBody}`}>
            Tailored self-care experiences for healthy skin, beautiful nails, and timeless
            relaxation.
        </p>
    </FadeIn>

    <!-- Mobile-First Interactive Luxury Filter Dock Carousel -->
    <FadeIn delay={0.1} class="relative z-10 mb-8 sm:mb-12">
        <nav
            aria-label="Pricing Categories Filter"
            class="-mx-4 flex overflow-x-auto px-4 py-2 scrollbar-none snap-x sm:mx-0 sm:justify-center sm:px-0"
        >
            <div
                class="inline-flex shrink-0 items-center rounded-full border border-nude/30 bg-linear-to-r from-cream/95 via-white/90 to-tertiary-100/90 p-1.5 shadow-[0_8px_28px_-6px_rgba(58,48,39,0.09)] backdrop-blur-md transition-all duration-300 sm:flex-wrap sm:justify-center"
            >
                <ul
                    class="flex shrink-0 items-center gap-1.5 sm:flex-wrap sm:justify-center"
                    role="tablist"
                >
                    {
                        filters.map((filter, index) => (
                            <li role="presentation" class="snap-start">
                                <button
                                    type="button"
                                    role="tab"
                                    aria-selected={index === 0 ? 'true' : 'false'}
                                    data-filter-target={filter.id}
