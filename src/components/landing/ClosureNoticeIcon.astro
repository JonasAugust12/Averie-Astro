---
import type { ClosureNoticeIcon } from '@/lib/closure-notice';
import { normalizeClosureIcon } from '@/lib/closure-notice';

interface Props {
    icon: ClosureNoticeIcon | string;
    class?: string;
}

const { icon: rawIcon, class: className = 'size-14 sm:size-16' } = Astro.props;
const icon = normalizeClosureIcon(rawIcon);
const stroke = 'currentColor';
const sw = '1.75';
---

{
    icon === 'storm' && (
        <svg
            class:list={[className, 'overflow-visible text-third']}
            viewBox="0 0 96 96"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
        >
            <path
                d="M25 57h43.5C78.7 57 84 51.4 84 43.5S77.6 29 69.7 29c-2.4 0-4.7.6-6.7 1.7C59.8 21.5 51.1 15 40.8 15 27.7 15 17 25.7 17 38.8v.7C10.7 41.4 7 46.6 7 52.2 7 61 14.2 66 23 66"
                fill="#E7E1DC"
                stroke="#786B62"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
            />
            <path
                class="storm-lightning"
                d="m49 54-10 18h9l-5 15 17-23H50l6-10H49Z"
                fill="#C78368"
                stroke="#9D604A"
                stroke-width="2"
                stroke-linejoin="round"
            />
            <path
                class="storm-rain storm-rain-one"
                d="m23 70-4 8"
                stroke="#87939C"
                stroke-width="3"
                stroke-linecap="round"
            />
            <path
                class="storm-rain storm-rain-two"
                d="m31 75-4 8"
                stroke="#87939C"
                stroke-width="3"
                stroke-linecap="round"
            />
            <path
                class="storm-rain storm-rain-three"
                d="m68 68-4 8"
                stroke="#87939C"
                stroke-width="3"
                stroke-linecap="round"
            />
            <path
                class="storm-rain storm-rain-four"
                d="m77 72-4 8"
                stroke="#87939C"
                stroke-width="3"
                stroke-linecap="round"
            />
        </svg>
    )
}
{
    icon === 'holiday' && (
        <svg
            class:list={[className, 'text-third']}
            viewBox="0 0 24 24"
            fill="none"
            stroke={stroke}
            stroke-width={sw}
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18" />
            <path d="M12 14l1.2 2.4L16 17l-2.8 1.2L12 21l-1.2-2.8L8 17l2.8-.6L12 14z" />
        </svg>
    )
}
{
    icon === 'maintenance' && (
        <svg
            class:list={[className, 'text-third']}
            viewBox="0 0 24 24"
            fill="none"
            stroke={stroke}
            stroke-width={sw}
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
        </svg>
    )
}
{
    icon === 'snow' && (
        <svg
            class:list={[className, 'text-third']}
            viewBox="0 0 24 24"
            fill="none"
            stroke={stroke}
            stroke-width={sw}
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
            <path d="M12 10v4M10 12h4M11 11l1 1M13 11l-1 1M11 13l1-1M13 13l-1-1" />
        </svg>
    )
}
{
    icon === 'health' && (
        <svg
            class:list={[className, 'text-third']}
            viewBox="0 0 24 24"
            fill="none"
            stroke={stroke}
            stroke-width={sw}
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
            <path d="M12 8v8M9 11h6" />
        </svg>
    )
}
{
    icon === 'general' && (
        <svg
            class:list={[className, 'text-third']}
            viewBox="0 0 24 24"
            fill="none"
            stroke={stroke}
            stroke-width={sw}
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <circle cx="12" cy="12" r="10" />
            <path d="M12 16v-4" />
            <path d="M12 8h.01" />
        </svg>
    )
}
