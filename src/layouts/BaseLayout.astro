---
import '@/styles/globals.css';
import SeoHead from '@/components/seo/SeoHead.astro';
import LoadingOverlay from '@/components/shared/LoadingOverlay.astro';
import { landingJsonLd } from '@/lib/json-ld';

const { title, description, canonical, robots } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <SeoHead
            title={title}
            description={description}
            canonical={canonical}
            robots={robots}
            jsonLd={landingJsonLd}
        />
    </head>
    <body class="antialiased">
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-100 focus:rounded-full focus:bg-third focus:px-4 focus:py-2 focus:text-cream"
        >
            Skip to main content
        </a>
        <div class="min-h-screen w-full bg-cream text-foreground">
            <div class="mx-auto w-full max-w-landing px-4 sm:px-6 lg:px-8 pt-0">
                <slot />
            </div>
        </div>
        <LoadingOverlay />
        <script>
            import { initLandingNav } from '@/scripts/landing-nav';
            import { initLandingFade } from '@/scripts/landing-fade';
            import { initBookingLoading } from '@/scripts/booking-loading';

            initLandingNav();
            initLandingFade();
            initBookingLoading();
            document.addEventListener('astro:page-load', () => {
                initLandingNav();
                initLandingFade();
                initBookingLoading();
            });
        </script>
    </body>
</html>

<style>
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
</style>
